model Student {
  id            String    @id @default(uuid())
  firstName     String    @map("first_name")
  middleName    String    @map("middle_name")
  lastName      String    @map("last_name")
  dateOfBirth   DateTime  @map("date_of_birth")
  startingGrade Int       @map("starting_grade")
  enrollmentDate DateTime @map("enrollment_date")
  enrolled      Boolean   @default(false)
  verifiedAt    DateTime?

  studentId          String        @unique @map("student_id")
  mustChangePassword Boolean       @default(true) @map("must_change_password")
  admissionDate      DateTime      @map("admission_date")
  sex                Sex
  address            String
  nationality        String
  previousSchool     String?       @map("previous_school")
  languagePreference String?       @map("language_preference")
  password           String
  phone              String?
  status             StudentStatus @default(ACTIVE)
  photoUrl           String?       @map("photo_url")

  profileId String          @unique @map("profile_id")
  profile   Profile         @relation(fields: [profileId], references: [id])
  tenantId  String          @map("tenant_id")
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  parents           StudentParent[]
  grades            StudentGrade[]
  attendanceRecords AttendanceRecord[]
  academicResults    AcademicResult[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("students")
}

model Section {
  id        String @id @default(uuid())
  name      String
  year      String
  capacity  Int    @default(30)

  gradeId  String @map("grade_id")
  grade    Grade  @relation(fields: [gradeId], references: [id])
  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  students          StudentGrade[]
  timetables        Timetable[]
  attendanceRecords AttendanceRecord[]
  teacherAssignments TeacherSectionSubject[]
  academicResults    AcademicResult[]
  academicRosters    AcademicRoster[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([branchId, gradeId, year, name])
  @@index([tenantId])
  @@map("sections")
}

model StudentGrade {
  id          String @id @default(uuid())
  grade       Int
  year        String
  studentCode String @map("student_code")

  studentId String  @map("student_id")
  student   Student @relation(fields: [studentId], references: [id])
  sectionId String  @map("section_id")
  section   Section @relation(fields: [sectionId], references: [id])
  branchId  String  @map("branch_id")
  branch    Branch  @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, grade])
  @@index([studentId])
  @@map("student_grades")
}

model StudentParent {
  id       String                @id @default(uuid())
  relation StudentParentRelation

  studentId String  @map("student_id")
  student   Student @relation(fields: [studentId], references: [id])
  parentId  String  @map("parent_id")
  parent    Parent  @relation(fields: [parentId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, parentId])
  @@index([studentId])
  @@map("students_parents")
}
