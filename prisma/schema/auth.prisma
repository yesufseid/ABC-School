model User {
  id          String @id @default(uuid())
  phoneNumber String @unique @map("phone_number")
  password    String
 
 // relationships
  profile Profile?
  parent  Parent?

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
