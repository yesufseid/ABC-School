model Tenant {
  id          String    @id @default(uuid())
  name        String
  description String
  details     Json
  verifiedAt  DateTime? @map("verified_at")
  settings    Json?

  members             Profile[]
  tenantSubscriptions TenantSubscription[]
  branches            Branch[]
  students            Student[]
  parents             Parent[]
  staffs              Staff[]
  teachers            Teacher[]
  grades              Grade[]
  sections            Section[]
  events              CalendarEvent[]
  timetables          Timetable[]
  attendanceRecords   AttendanceRecord[]
  staffAttendance     StaffAttendance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenants")
}

model Branch {
  id           String @id @default(uuid())
  name         String
  description  String
  details      Json
  branchCode   String @map("branch_code")
  branchPrefix String @unique @map("branch_prefix")

  // relationships
  tenantId String         @map("tenant_id")
  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  students StudentGrade[]
  staffs   Staff[]
  teachers Teacher[]
  sections Section[]
  events   EventBranch[]
  staffAttendance StaffAttendance[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, branchCode])
  @@index([tenantId])
  @@map("branches")
}

model Profile {
  id   String      @id @default(uuid())
  name String
  type ProfileType

  userId   String   @unique @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String?  @map("tenant_id")
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  students Student?
  parents  Parent?
  staff    Staff?
  teacher         Teacher?
  staffAttendance StaffAttendance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId])
  @@index([tenantId])
  @@map("profiles")
}
